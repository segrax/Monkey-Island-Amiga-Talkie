file(GLOB_RECURSE payloads CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}/assets" "${CMAKE_CURRENT_SOURCE_DIR}/assets/*")
set(embed "#include \"builder.hpp\"\nnamespace talkie {\n")
set(index "")
set(i 0)
foreach(name IN LISTS payloads)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/assets/${name}")
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/assets/${name}" bytes HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${bytes}")
  string(APPEND embed "static const unsigned char data_${i}[] = {${bytes}};\n")
  string(APPEND index "{\"${name}\",data_${i},sizeof(data_${i})},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND embed "const std::vector<Asset>& assets() { static const std::vector<Asset> values = {${index}}; return values; }\n}\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/payload.cpp" "${embed}")
